{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/slide-specs.schema.json",
  "title": "Slide Specifications",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "deck_id",
    "slides"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.(1|2)\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "deck_id": {
      "type": "string",
      "pattern": "^DECK-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "status": {"enum": ["draft", "reviewed", "approved", "frozen"]},
    "repair_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^PRP-[A-F0-9]{16}$"}
    },
    "art_direction_seed": {"$ref": "#/$defs/artDirectionSeedRef"},
    "planning_lineage": {"$ref": "#/$defs/planningLineage"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_id",
          "audience_question",
          "core_message",
          "content_blocks",
          "visual_intent",
          "density_budget",
          "editability_intent"
        ],
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^S-[0-9]{3}$"
          },
          "section_id": {"type": "string", "pattern": "^SEC-[0-9]{2}$"},
          "slide_type": {
            "enum": [
              "cover", "agenda", "section", "statement", "evidence", "process",
              "comparison", "timeline", "matrix", "architecture", "chart", "case",
              "quote", "summary", "action", "appendix"
            ]
          },
          "status": {"enum": ["draft", "reviewed", "approved", "frozen"]},
          "outline_slide_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slide_id", "content_hash"],
            "properties": {
              "slide_id": {"type": "string", "pattern": "^S-[0-9]{3}$"},
              "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          },
          "revision_note": {"type": "string"},
          "audience_question": {
            "type": "string"
          },
          "core_message": {
            "type": "string",
            "minLength": 1
          },
          "content_blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "block_id",
                "semantic_role",
                "content_type",
                "priority",
                "content",
                "evidence_ids"
              ],
              "properties": {
                "block_id": {
                  "type": "string",
                  "pattern": "^BLK-S[0-9]{3}-[0-9]{2}$"
                },
                "semantic_role": {
                  "enum": [
                    "headline",
                    "subhead",
                    "body",
                    "metric",
                    "evidence",
                    "label",
                    "caption",
                    "quote",
                    "chart",
                    "image",
                    "icon",
                    "diagram",
                    "table",
                    "footer"
                  ]
                },
                "content_type": {
                  "enum": [
                    "text",
                    "list",
                    "metric",
                    "quote",
                    "image",
                    "icon",
                    "chart",
                    "table",
                    "diagram",
                    "spacer"
                  ]
                },
                "priority": {
                  "enum": [
                    "primary",
                    "secondary",
                    "tertiary",
                    "decorative"
                  ]
                },
                "content": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "object"
                          }
                        ]
                      }
                    },
                    {
                      "type": "object"
                    }
                  ]
                },
                "evidence_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^EVD-[0-9]{3}$"
                  }
                },
                "evidence_requirement": {
                  "enum": ["required", "optional", "none"]
                },
                "evidence_qualification": {
                  "type": ["string", "null"],
                  "minLength": 1
                },
                "claim_mode": {
                  "enum": ["label", "fact", "interpretation", "instruction", "asset"]
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "origin": {"enum": ["provider", "manual", "repair"]},
                "asset_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^AST-[0-9]{3}$"
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "visual_intent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relationship",
              "suggested_layout_families",
              "avoid"
            ],
            "properties": {
              "relationship": {
                "type": "string"
              },
              "suggested_layout_families": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                }
              },
              "avoid": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "representation": {"$ref": "#/$defs/representation"},
          "speaker_notes": {
            "type": "string"
          },
          "density_budget": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_blocks",
              "max_words",
              "min_body_pt"
            ],
            "properties": {
              "max_blocks": {
                "type": "integer",
                "minimum": 1
              },
              "max_words": {
                "type": "integer",
                "minimum": 1
              },
              "min_body_pt": {
                "type": "number",
                "minimum": 8
              }
            }
          },
          "editability_intent": {
            "enum": [
              "E0",
              "E1",
              "E2",
              "E3",
              "E4"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"pattern": "^0\\.2\\."}}},
      "then": {
        "properties": {
          "slides": {
            "items": {"required": ["representation"]}
          }
        }
      }
    }
  ],
  "$defs": {
    "assetStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demand", "asset_refs", "fallback"],
      "properties": {
        "demand": {"enum": ["none", "preferred", "required"]},
        "asset_refs": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^AST-[0-9]{3}$"}
        },
        "fallback": {"enum": ["replan", "textual", "table", "none"]}
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation_id", "kind", "carrier_reason", "visual_weight", "density_role",
        "asset_strategy", "semantics"
      ],
      "properties": {
        "representation_id": {"type": "string", "pattern": "^REP-S[0-9]{3}$"},
        "kind": {"enum": ["text", "typographic", "image", "chart", "table", "diagram", "mixed"]},
        "carrier_reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "visual_weight": {"enum": ["hero", "primary", "supporting", "background"]},
        "density_role": {"enum": ["anchor", "proof", "context", "navigation"]},
        "asset_strategy": {"$ref": "#/$defs/assetStrategy"},
        "semantics": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["text", "typographic"]}}},
          "then": {"properties": {"semantics": {"$ref": "#/$defs/textSemantics"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "image"}}},
          "then": {"properties": {"semantics": {"$ref": "#/$defs/imageSemantics"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "chart"}}},
          "then": {"properties": {"semantics": {"$ref": "#/$defs/chartSemantics"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "table"}}},
          "then": {"properties": {"semantics": {"$ref": "#/$defs/tableSemantics"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "diagram"}}},
          "then": {"properties": {"semantics": {"$ref": "#/$defs/diagramSemantics"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "mixed"}}},
          "then": {"properties": {"semantics": {"$ref": "#/$defs/mixedSemantics"}}}
        }
      ]
    },
    "textSemantics": {
      "type": "object", "additionalProperties": false,
      "required": ["structure", "emphasis"],
      "properties": {
        "structure": {"enum": ["statement", "sequence", "comparison", "explanation", "quote"]},
        "emphasis": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "imageSemantics": {
      "type": "object", "additionalProperties": false,
      "required": ["narrative_role", "subject", "focal_intent", "source_strategy"],
      "properties": {
        "narrative_role": {"enum": ["evidence", "context", "emotion", "identity", "metaphor"]},
        "subject": {"type": "string", "minLength": 1, "maxLength": 1000},
        "focal_intent": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_strategy": {"enum": ["existing", "generate", "acquire", "replan"]}
      }
    },
    "chartSemantics": {
      "type": "object", "additionalProperties": false,
      "required": [
        "communication_question", "chart_type", "categories", "series",
        "comparison_semantics", "data_evidence_ids", "fallback"
      ],
      "properties": {
        "communication_question": {"type": "string", "minLength": 1, "maxLength": 1000},
        "chart_type": {"enum": ["bar", "line", "pie", "doughnut", "area"]},
        "categories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "series": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "values"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "values": {"type": "array", "minItems": 1, "items": {"type": "number"}}
            }
          }
        },
        "comparison_semantics": {"enum": ["magnitude", "trend", "composition", "distribution", "ranking"]},
        "data_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[0-9]{3}$"}},
        "fallback": {"enum": ["table", "metric", "prose", "replan"]}
      }
    },
    "tableSemantics": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_task", "columns", "row_hierarchy", "emphasized_dimension", "source_evidence_ids"],
      "properties": {
        "decision_task": {"type": "string", "minLength": 1, "maxLength": 1000},
        "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "row_hierarchy": {"enum": ["flat", "grouped", "ranked"]},
        "emphasized_dimension": {"type": "string", "minLength": 1, "maxLength": 500},
        "source_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[0-9]{3}$"}}
      }
    },
    "diagramSemantics": {
      "type": "object", "additionalProperties": false,
      "required": ["topology", "nodes", "edges"],
      "properties": {
        "topology": {"enum": ["flow", "hierarchy", "cycle", "network"]},
        "nodes": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "label", "role"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
              "label": {"type": "string", "minLength": 1, "maxLength": 500},
              "role": {"type": "string", "minLength": 1, "maxLength": 120}
            }
          }
        },
        "edges": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "from", "to", "meaning", "direction"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
              "from": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
              "to": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
              "meaning": {"type": "string", "minLength": 1, "maxLength": 500},
              "direction": {"enum": ["forward", "backward", "bidirectional"]}
            }
          }
        }
      }
    },
    "mixedSemantics": {
      "type": "object", "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "children": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "priority"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
              "kind": {"enum": ["text", "typographic", "image", "chart", "table", "diagram"]},
              "priority": {"enum": ["primary", "secondary", "tertiary"]}
            }
          }
        }
      }
    },
    "artDirectionSeedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_id", "path", "content_hash", "provider"],
      "properties": {
        "seed_id": {"type": "string", "pattern": "^ADS-[A-F0-9]{16}$"},
        "path": {"type": "string", "pattern": "^\\.slidethus/art-direction/seeds/[a-f0-9]{64}\\.json$"},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "mode"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "mode": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "semantic_scope": {"enum": ["claims"]},
        "semantic_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "planningLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id", "engine", "engine_version", "provider", "generated_at",
        "proposal_hash", "policy", "policy_hash", "input_refs", "warnings", "assumptions"
      ],
      "properties": {
        "lineage_id": {"type": "string", "pattern": "^PLN-[A-F0-9]{16}$"},
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "generated_at": {"type": "string", "format": "date-time"},
        "proposal_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "limits"],
          "properties": {
            "service": {"enum": ["narrative", "outline", "slide_specs", "layout"]},
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_blocking_questions", "max_assumptions", "max_sections", "max_slides",
                "max_blocks_per_slide", "max_words_per_slide", "max_provider_payload_bytes",
                "max_change_targets"
              ],
              "properties": {
                "max_blocking_questions": {"type": "integer", "minimum": 1},
                "max_assumptions": {"type": "integer", "minimum": 1},
                "max_sections": {"type": "integer", "minimum": 1},
                "max_slides": {"type": "integer", "minimum": 1},
                "max_blocks_per_slide": {"type": "integer", "minimum": 1},
                "max_words_per_slide": {"type": "integer", "minimum": 1},
                "max_provider_payload_bytes": {"type": "integer", "minimum": 1},
                "max_change_targets": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "policy_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "input_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
        "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
