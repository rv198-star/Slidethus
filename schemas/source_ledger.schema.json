{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/source-ledger.schema.json",
  "title": "Source Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "kind",
          "title",
          "path_or_url",
          "ownership",
          "confidentiality",
          "authority_tier",
          "parse_status",
          "allowed_use"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC-[0-9]{3}$"
          },
          "kind": {
            "enum": [
              "user_file",
              "web",
              "existing_deck",
              "dataset",
              "image",
              "internal_knowledge",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path_or_url": {
            "type": "string",
            "minLength": 1
          },
          "ownership": {
            "enum": [
              "user_owned",
              "licensed",
              "public_reference",
              "unknown"
            ]
          },
          "confidentiality": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "authority_tier": {
            "enum": [
              "user",
              "primary",
              "secondary",
              "community",
              "unknown"
            ]
          },
          "freshness_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "ingestion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parser_name",
              "parser_version",
              "detected_family",
              "snapshot_path",
              "snapshot_sha256",
              "chunk_count",
              "warning_count",
              "risk_count",
              "limits",
              "ingested_at"
            ],
            "properties": {
              "parser_name": {
                "type": "string",
                "minLength": 1
              },
              "parser_version": {
                "type": "string",
                "minLength": 1
              },
              "detected_family": {
                "type": "string",
                "minLength": 1
              },
              "snapshot_path": {
                "type": "string",
                "pattern": "^\\.slidethus/cache/ingestion/[a-f0-9]{64}\\.json$"
              },
              "snapshot_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "chunk_count": {
                "type": "integer",
                "minimum": 1
              },
              "warning_count": {
                "type": "integer",
                "minimum": 0
              },
              "risk_count": {
                "type": "integer",
                "minimum": 0
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max_source_bytes",
                  "max_chunks",
                  "max_chunk_chars"
                ],
                "properties": {
                  "max_source_bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_chunks": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_chunk_chars": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "ingested_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "parse_status": {
            "enum": [
              "pending",
              "parsed",
              "partial",
              "unreadable",
              "skipped"
            ]
          },
          "allowed_use": {
            "enum": [
              "full",
              "internal_only",
              "citation_only",
              "metadata_only",
              "do_not_use"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
