{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/host-candidate-receipt.schema.json",
  "title": "Host render attempt, never release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt_id", "status", "scope", "slide_ids", "renderer",
    "artifacts", "renderer_ir", "preflight", "input", "outputs", "office_review",
    "release_approved", "diagnostics"
  ],
  "properties": {
    "schema_version": {"enum": ["0.2.0", "0.3.0"]},
    "attempt_id": {"type": "string", "pattern": "^HCA-[A-F0-9]{16}$"},
    "status": {
      "enum": [
        "render_started", "render_failed", "render_timed_out",
        "candidate_office_review_pending"
      ]
    },
    "scope": {"enum": ["sample", "full"]},
    "slide_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^S-[0-9]{3}$"}
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "adapter_sha256"],
      "properties": {
        "name": {"const": "artifact-tool"},
        "version": {"type": "string", "minLength": 1},
        "adapter_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "dependency_key": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "producer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "version", "adapter_sha256", "capability_id", "capability_hash"],
      "properties": {
        "backend": {"const": "artifact-tool"},
        "version": {"type": "string", "minLength": 1},
        "adapter_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "capability_id": {"const": "artifact-tool-closed-grammar-v2"},
        "capability_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "calibration_authorization": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dependency_key", "decision_path", "reference_set_path",
            "renderer_ir_sha256", "producer"
          ],
          "properties": {
            "dependency_key": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "decision_path": {"type": "string", "minLength": 1},
            "reference_set_path": {"type": "string", "minLength": 1},
            "renderer_ir_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "producer": {"type": "object"}
          }
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "renderer_ir": {"$ref": "#/$defs/file"},
    "preflight": {"$ref": "#/$defs/file"},
    "input": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/file"}
      ]
    },
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "office_review": {"enum": ["not_started", "pending", "evidence_pending", "review_pending", "reviewed"]},
    "office": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "application", "build", "profile", "export_parameters", "pages"],
      "properties": {
        "status": {"enum": ["not_requested", "evidence_pending", "available", "reviewed"]},
        "application": {"type": ["string", "null"]},
        "build": {"type": ["string", "null"]},
        "profile": {"type": ["string", "null"]},
        "export_parameters": {"type": ["object", "null"]},
        "pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slide_id", "path", "sha256"],
            "properties": {
              "slide_id": {"type": "string", "pattern": "^S-[0-9]{3}$"},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "release_approved": {"const": false},
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage", "started_at", "finished_at", "duration_seconds", "exit_code",
        "timed_out", "stdout", "stderr", "error"
      ],
      "properties": {
        "stage": {
          "enum": ["prepared", "input", "adapter", "integrity", "outputs", "complete"]
        },
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "exit_code": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "stdout": {"type": "string", "maxLength": 4000},
        "stderr": {"type": "string", "maxLength": 4000},
        "error": {"type": ["string", "null"], "maxLength": 4000}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "0.3.0"}}},
      "then": {
        "required": ["dependency_key", "producer_identity", "calibration_authorization", "office"],
        "properties": {
          "dependency_key": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "candidate_office_review_pending"}}},
      "then": {
        "properties": {
          "input": {"$ref": "#/$defs/file"},
          "outputs": {"minItems": 3},
          "office_review": {"enum": ["pending", "evidence_pending", "review_pending", "reviewed"]},
          "diagnostics": {
            "properties": {
              "stage": {"const": "complete"},
              "finished_at": {"type": "string", "format": "date-time"},
              "duration_seconds": {"type": "number", "minimum": 0},
              "timed_out": {"const": false},
              "error": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "render_started"}}},
      "then": {
        "properties": {
          "office_review": {"const": "not_started"},
          "diagnostics": {
            "properties": {
              "finished_at": {"type": "null"},
              "duration_seconds": {"type": "null"},
              "exit_code": {"type": "null"},
              "timed_out": {"const": false},
              "error": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["render_failed", "render_timed_out"]}}},
      "then": {
        "properties": {
          "office_review": {"const": "not_started"},
          "diagnostics": {
            "properties": {
              "finished_at": {"type": "string", "format": "date-time"},
              "duration_seconds": {"type": "number", "minimum": 0},
              "error": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "render_timed_out"}}},
      "then": {"properties": {"diagnostics": {"properties": {"timed_out": {"const": true}}}}}
    }
  ],
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
