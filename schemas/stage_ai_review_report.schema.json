{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/stage-ai-review-report.schema.json",
  "title": "Stage AI Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "report_id", "review_mode", "stage", "provider",
    "capability", "workflow_report", "inputs", "application_outputs", "failure_facts",
    "issues", "summary", "status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "report_id": {"type": "string", "pattern": "^SAR-[A-F0-9]{16}$"},
    "review_mode": {"const": "retrospective_stage_open_issue"},
    "stage": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5A", "P5B", "P6", "P7"]},
    "provider": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": {"enum": ["available", "missing", "not_applicable"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "workflow_report": {"$ref": "#/$defs/workflowRef"},
    "inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "application_outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/runtimeRef"}
    },
    "failure_facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/failureFact"}
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_count", "major_count", "minor_count", "suggestion_count", "open_count"
      ],
      "properties": {
        "critical_count": {"type": "integer", "minimum": 0},
        "major_count": {"type": "integer", "minimum": 0},
        "minor_count": {"type": "integer", "minimum": 0},
        "suggestion_count": {"type": "integer", "minimum": 0},
        "open_count": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["pass", "issues", "blocked", "not_applicable"]}
  },
  "$defs": {
    "workflowRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "path", "sha256", "workflow", "status", "final_phase"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^WFR-[A-F0-9]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "workflow": {"enum": ["create", "rebuild", "improve", "audit", "revise", "extract_style"]},
        "status": {"enum": ["ready", "blocked", "failed"]},
        "final_phase": {"type": "string", "minLength": 1}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "runtimeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref_id", "path", "sha256", "status"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "ref_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "failureFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "code", "message"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 128},
        "code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id", "code", "severity", "status", "observed_stage", "earliest_phase",
        "artifact_type", "slide_id", "block_id", "region_id", "scope", "finding", "impact",
        "generalized_pattern_hint", "verification"
      ],
      "properties": {
        "issue_id": {"type": "string", "pattern": "^SAI-[A-F0-9]{16}$"},
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
        "severity": {"enum": ["critical", "major", "minor", "suggestion"]},
        "status": {"const": "open"},
        "observed_stage": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5A", "P5B", "P6", "P7"]},
        "earliest_phase": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5A", "P5B", "P6", "P7"]},
        "artifact_type": {"type": ["string", "null"], "minLength": 1},
        "slide_id": {"type": ["string", "null"], "pattern": "^S-[0-9]{3}$"},
        "block_id": {"type": ["string", "null"], "pattern": "^BLK-S[0-9]{3}-[0-9]{2}$"},
        "region_id": {"type": ["string", "null"], "pattern": "^REG-S[0-9]{3}-[0-9]{2}$"},
        "scope": {"enum": ["local", "multi_slide", "artifact", "cross_artifact", "cross_stage", "attempt_wide"]},
        "finding": {"type": "string", "minLength": 1, "maxLength": 4000},
        "impact": {"type": "string", "minLength": 1, "maxLength": 4000},
        "generalized_pattern_hint": {"type": "string", "minLength": 1, "maxLength": 4000},
        "verification": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    }
  }
}
