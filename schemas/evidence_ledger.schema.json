{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/evidence-ledger.schema.json",
  "title": "Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "research_cycles",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "claim",
          "support_status",
          "source_refs",
          "use_policy"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EVD-[0-9]{3}$"
          },
          "claim_key": {
            "type": "string",
            "pattern": "^CLK-[A-F0-9]{16}$"
          },
          "candidate_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CND-[A-F0-9]{16}$"
            }
          },
          "candidate_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_id",
                "source_id",
                "locator",
                "support_type",
                "origin_kind",
                "source_chunk_id",
                "content_hash",
                "research_run_id",
                "research_result_id",
                "conflict_key",
                "stance",
                "freshness_date"
              ],
              "properties": {
                "candidate_id": {"type": "string", "pattern": "^CND-[A-F0-9]{16}$"},
                "source_id": {"type": ["string", "null"], "pattern": "^SRC-[0-9]{3}$"},
                "locator": {"type": ["string", "null"], "minLength": 1},
                "support_type": {"enum": ["direct", "indirect", "context"]},
                "origin_kind": {"enum": ["source_chunk", "research_summary", "inference", "assumption"]},
                "source_chunk_id": {"type": ["string", "null"], "pattern": "^CHK-SRC-[0-9]{3}-[0-9]{4}-[A-F0-9]{8}$"},
                "content_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
                "research_run_id": {"type": ["string", "null"], "pattern": "^RRN-[A-F0-9]{16}$"},
                "research_result_id": {"type": ["string", "null"], "pattern": "^RSLT-[A-F0-9]{16}$"},
                "conflict_key": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
                "stance": {"type": ["string", "null"], "enum": ["supports", "opposes", "neutral", null]},
                "freshness_date": {"type": ["string", "null"]}
              }
            }
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "support_status": {
            "enum": [
              "verified",
              "provisional",
              "disputed",
              "unsupported",
              "inference",
              "assumption"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator",
                "support_type"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^SRC-[0-9]{3}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "support_type": {
                  "enum": [
                    "direct",
                    "indirect",
                    "context"
                  ]
                },
                "chunk_id": {
                  "type": "string",
                  "pattern": "^CHK-SRC-[0-9]{3}-[0-9]{4}-[A-F0-9]{8}$"
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "freshness_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "authority_decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strongest_tier", "weakest_tier", "source_tiers", "reason_codes"],
            "properties": {
              "strongest_tier": {"enum": ["primary", "user", "secondary", "community", "unknown"]},
              "weakest_tier": {"enum": ["primary", "user", "secondary", "community", "unknown"]},
              "source_tiers": {
                "type": "array",
                "uniqueItems": true,
                "items": {"enum": ["primary", "user", "secondary", "community", "unknown"]}
              },
              "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "freshness_decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "cutoff_date", "evaluated_date", "reason_codes"],
            "properties": {
              "status": {"enum": ["current", "stale", "unknown", "not_required"]},
              "cutoff_date": {"type": ["string", "null"]},
              "evaluated_date": {"type": ["string", "null"]},
              "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "conflict_group": {
            "type": ["string", "null"],
            "pattern": "^CFG-[A-F0-9]{16}$"
          },
          "conflict_stances": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["supports", "opposes", "neutral"]}
          },
          "adjudication": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine", "version", "reason_codes"],
            "properties": {
              "engine": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "conflict_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "use_policy": {
            "enum": [
              "allowed_with_citation",
              "allowed_with_qualification",
              "internal_only",
              "do_not_use"
            ]
          },
          "reasoning": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "research_cycles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cycle_id",
          "kind",
          "status",
          "basis",
          "outline_version",
          "source_ids",
          "notes",
          "query_count",
          "waiver_reason"
        ],
        "properties": {
          "cycle_id": {
            "type": "string",
            "pattern": "^RSC-[0-9]{3}$"
          },
          "kind": {
            "enum": [
              "orientation",
              "targeted"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "complete",
              "waived",
              "blocked"
            ]
          },
          "basis": {
            "enum": [
              "user_materials",
              "external_research",
              "mixed",
              "none_required"
            ]
          },
          "outline_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SRC-[0-9]{3}$"
            }
          },
          "run_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RRN-[A-F0-9]{16}$"
            }
          },
          "query_count": {
            "type": "integer",
            "minimum": 0
          },
          "waiver_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "orientation"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "outline_version": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "targeted"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "outline_version": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "waived"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "waiver_reason"
              ],
              "properties": {
                "waiver_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "complete"
                },
                "basis": {
                  "not": {
                    "const": "none_required"
                  }
                }
              },
              "required": [
                "status",
                "basis"
              ]
            },
            "then": {
              "properties": {
                "source_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
