{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/release-rights-policy.schema.json",
  "title": "Slidethus Release Rights Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_license",
    "project_owned",
    "excluded_from_project_license",
    "default_release_excludes",
    "asset_policy",
    "font_policy",
    "model_policy",
    "prepared_environment_policy"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project_license": {"const": "Apache-2.0"},
    "project_owned": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "excluded_from_project_license": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/policyItem"}
    },
    "default_release_excludes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "asset_policy": {"$ref": "#/$defs/policyText"},
    "font_policy": {"$ref": "#/$defs/policyText"},
    "model_policy": {"$ref": "#/$defs/policyText"},
    "prepared_environment_policy": {"$ref": "#/$defs/policyText"}
  },
  "$defs": {
    "policyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "reason", "release_default"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "release_default": {"enum": ["exclude", "reference_only", "rights_review"]}
      }
    },
    "policyText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "rule"],
      "properties": {
        "default": {"enum": ["exclude", "reference_only", "rights_cleared_only", "external_terms"]},
        "rule": {"type": "string", "minLength": 1}
      }
    }
  }
}
