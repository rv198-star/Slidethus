{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/deck-outline.schema.json",
  "title": "Deck Outline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "deck_id",
    "target_page_count",
    "slides"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "deck_id": {
      "type": "string",
      "pattern": "^DECK-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "status": {
      "enum": ["draft", "reviewed", "approved", "frozen"]
    },
    "target_page_count": {
      "type": "integer",
      "minimum": 1
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_id",
          "ordinal",
          "section_id",
          "slide_type",
          "headline",
          "takeaway",
          "purpose",
          "evidence_ids",
          "status"
        ],
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^S-[0-9]{3}$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "section_id": {
            "type": "string",
            "pattern": "^SEC-[0-9]{2}$"
          },
          "slide_type": {
            "enum": [
              "cover",
              "agenda",
              "section",
              "statement",
              "evidence",
              "process",
              "comparison",
              "timeline",
              "matrix",
              "architecture",
              "chart",
              "case",
              "quote",
              "summary",
              "action",
              "appendix"
            ]
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "takeaway": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EVD-[0-9]{3}$"
            }
          },
          "evidence_requirement": {
            "enum": ["required", "optional", "none"]
          },
          "evidence_qualification": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "narrative_section_ref": {
            "type": "string",
            "pattern": "^SEC-[0-9]{2}$"
          },
          "audience_question": {"type": "string"},
          "content_scope": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "derived_from_slide_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^S-[0-9]{3}$"}
          },
          "operation_id": {
            "type": ["string", "null"],
            "pattern": "^PCH-[A-F0-9]{16}$"
          },
          "locked_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "section_id",
                "slide_type",
                "headline",
                "takeaway",
                "purpose",
                "evidence_ids",
                "position",
                "all"
              ]
            }
          },
          "estimated_minutes": {"type": ["number", "null"], "minimum": 0},
          "revision_note": {"type": "string"},
          "transition_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "transition_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "reviewed",
              "approved",
              "frozen",
              "excluded"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "appendix_policy": {
      "type": "string"
    },
    "operations_applied": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^PCH-[A-F0-9]{16}$"}
    },
    "planning_lineage": {"$ref": "#/$defs/planningLineage"}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "semantic_scope": {"enum": ["claims"]},
        "semantic_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "planningLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id",
        "engine",
        "engine_version",
        "provider",
        "generated_at",
        "proposal_hash",
        "policy",
        "policy_hash",
        "input_refs",
        "warnings",
        "assumptions"
      ],
      "properties": {
        "lineage_id": {"type": "string", "pattern": "^PLN-[A-F0-9]{16}$"},
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "generated_at": {"type": "string", "format": "date-time"},
        "proposal_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "limits"],
          "properties": {
            "service": {"enum": ["narrative", "outline", "slide_specs", "layout"]},
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_blocking_questions", "max_assumptions", "max_sections", "max_slides",
                "max_blocks_per_slide", "max_words_per_slide", "max_provider_payload_bytes",
                "max_change_targets"
              ],
              "properties": {
                "max_blocking_questions": {"type": "integer", "minimum": 1},
                "max_assumptions": {"type": "integer", "minimum": 1},
                "max_sections": {"type": "integer", "minimum": 1},
                "max_slides": {"type": "integer", "minimum": 1},
                "max_blocks_per_slide": {"type": "integer", "minimum": 1},
                "max_words_per_slide": {"type": "integer", "minimum": 1},
                "max_provider_payload_bytes": {"type": "integer", "minimum": 1},
                "max_change_targets": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "policy_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "input_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
        "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
