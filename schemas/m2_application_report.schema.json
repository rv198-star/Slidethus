{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/m2-application-report.schema.json",
  "title": "M2 Application Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "report_id",
    "generated_at",
    "status",
    "delivery_level",
    "mode",
    "inputs",
    "capabilities",
    "actions",
    "blockers",
    "warnings",
    "security",
    "outputs"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "report_id": {"type": "string", "pattern": "^M2R-[A-F0-9]{16}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready", "degraded", "blocked", "rework_required", "failed"]},
    "delivery_level": {"enum": ["D0", "D1", "D2", "D3", "D4", "D5"]},
    "mode": {"enum": ["full", "user_materials", "offline_degraded"]},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_brief", "requested_sources", "config", "config_hash"],
      "properties": {
        "project_brief": {"$ref": "#/$defs/artifactRef"},
        "requested_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size_bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 4096},
              "size_bytes": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "config": {"$ref": "#/$defs/applicationConfig"},
        "config_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "status", "detail"],
        "properties": {
          "capability": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"enum": ["available", "degraded", "missing"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "stage", "status", "detail", "refs"],
        "properties": {
          "action_id": {"type": "string", "pattern": "^M2A-[0-9]{3}$"},
          "stage": {"enum": ["brief", "sources", "evidence", "orientation_research", "g2", "planning_revalidation", "targeted_research", "gap_analysis", "g5a", "report"]},
          "status": {"enum": ["complete", "skipped", "blocked", "failed"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 4000},
          "refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
        }
      }
    },
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_disclosure_approved", "high_risk_source_evidence_allowed", "excluded_source_ids", "high_risk_finding_count"],
      "properties": {
        "external_disclosure_approved": {"type": "boolean"},
        "high_risk_source_evidence_allowed": {"type": "boolean"},
        "excluded_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{3}$"}},
        "high_risk_finding_count": {"type": "integer", "minimum": 0}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "evidence_ids", "research_run_ids", "research_runs", "gap_report_path", "gap_report_sha256", "artifact_refs", "final_phase", "gates"],
      "properties": {
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{3}$"}},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[0-9]{3}$"}},
        "research_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RRN-[A-F0-9]{16}$"}},
        "research_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "snapshot_path", "snapshot_sha256", "status", "cycle_id"],
            "properties": {
              "run_id": {"type": "string", "pattern": "^RRN-[A-F0-9]{16}$"},
              "snapshot_path": {"type": "string", "minLength": 1, "maxLength": 4096},
              "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "status": {"enum": ["planned", "running", "complete", "partial", "blocked", "failed"]},
              "cycle_id": {"type": "string", "pattern": "^RSC-[0-9]{3}$"}
            }
          }
        },
        "gap_report_path": {"type": ["string", "null"], "maxLength": 4096},
        "gap_report_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "artifact_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
        "final_phase": {"enum": ["CREATED", "BRIEF_READY", "SOURCES_READY", "EVIDENCE_READY", "NARRATIVE_READY", "OUTLINE_READY", "SLIDE_SPECS_READY", "LAYOUT_READY", "VISUAL_SYSTEM_READY", "DRAFT_RENDERED", "REVIEWED", "DELIVERY_READY", "COMPLETED"]},
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate_id", "status", "reasons"],
            "properties": {
              "gate_id": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5A"]},
              "status": {"enum": ["pass", "fail", "blocked", "waived", "not_applicable"]},
              "reasons": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 4000}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "applicationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limits",
        "allow_research_degraded",
        "approve_external_disclosure",
        "allow_high_risk_source_evidence",
        "advance_existing_planning",
        "provider"
      ],
      "properties": {
        "limits": {"$ref": "#/$defs/applicationLimits"},
        "allow_research_degraded": {"type": "boolean"},
        "approve_external_disclosure": {"type": "boolean"},
        "allow_high_risk_source_evidence": {"type": "boolean"},
        "advance_existing_planning": {"type": "boolean"},
        "provider": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version"],
              "properties": {
                "name": {"type": "string", "minLength": 1, "maxLength": 128},
                "version": {"type": "string", "minLength": 1, "maxLength": 128}
              }
            }
          ]
        }
      }
    },
    "applicationLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_sources", "max_total_source_bytes", "source", "research"],
      "properties": {
        "max_sources": {"type": "integer", "minimum": 1},
        "max_total_source_bytes": {"type": "integer", "minimum": 1},
        "source": {"$ref": "#/$defs/sourceLimits"},
        "research": {"$ref": "#/$defs/researchLimits"}
      }
    },
    "sourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_bytes",
        "max_chunks",
        "max_chunk_chars",
        "max_risks",
        "max_pages",
        "max_slides",
        "max_sheets",
        "max_rows",
        "max_cells",
        "max_archive_entries",
        "max_archive_member_bytes",
        "max_uncompressed_bytes",
        "max_image_pixels"
      ],
      "properties": {
        "max_source_bytes": {"type": "integer", "minimum": 1},
        "max_chunks": {"type": "integer", "minimum": 1},
        "max_chunk_chars": {"type": "integer", "minimum": 1},
        "max_risks": {"type": "integer", "minimum": 1},
        "max_pages": {"type": "integer", "minimum": 1},
        "max_slides": {"type": "integer", "minimum": 1},
        "max_sheets": {"type": "integer", "minimum": 1},
        "max_rows": {"type": "integer", "minimum": 1},
        "max_cells": {"type": "integer", "minimum": 1},
        "max_archive_entries": {"type": "integer", "minimum": 1},
        "max_archive_member_bytes": {"type": "integer", "minimum": 1},
        "max_uncompressed_bytes": {"type": "integer", "minimum": 1},
        "max_image_pixels": {"type": "integer", "minimum": 1}
      }
    },
    "researchLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_queries",
        "max_query_chars",
        "max_results_per_query",
        "max_total_results",
        "max_title_chars",
        "max_summary_chars",
        "max_metadata_bytes",
        "cache_ttl_seconds"
      ],
      "properties": {
        "max_queries": {"type": "integer", "minimum": 1},
        "max_query_chars": {"type": "integer", "minimum": 1},
        "max_results_per_query": {"type": "integer", "minimum": 1},
        "max_total_results": {"type": "integer", "minimum": 1},
        "max_title_chars": {"type": "integer", "minimum": 1},
        "max_summary_chars": {"type": "integer", "minimum": 1},
        "max_metadata_bytes": {"type": "integer", "minimum": 1},
        "cache_ttl_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "code", "message"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^M2[BRW]-[A-F0-9]{16}$"},
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    }
  }
}
