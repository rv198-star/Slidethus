{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/project-brief.schema.json",
  "title": "Slidethus Project Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "language",
    "intent",
    "audiences",
    "constraints",
    "source_policy",
    "approval_mode",
    "quality_profile",
    "assumptions",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "desired_outcome",
        "presentation_mode",
        "delivery_context"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "desired_outcome": {
          "type": "string",
          "minLength": 1
        },
        "presentation_mode": {
          "enum": [
            "live",
            "read",
            "both"
          ]
        },
        "delivery_context": {
          "type": "string",
          "minLength": 1
        },
        "call_to_action": {
          "type": "string"
        }
      }
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audience_id",
          "role",
          "needs",
          "decision_power",
          "knowledge_level"
        ],
        "properties": {
          "audience_id": {
            "type": "string",
            "pattern": "^AUD-[0-9]{2}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "objections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_power": {
            "enum": [
              "none",
              "influencer",
              "decision_maker",
              "mixed"
            ]
          },
          "knowledge_level": {
            "enum": [
              "novice",
              "intermediate",
              "expert",
              "mixed"
            ]
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_count",
        "aspect_ratio",
        "output_formats",
        "editability_target"
      ],
      "properties": {
        "page_count": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "target",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "target": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "duration_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "aspect_ratio": {
          "enum": [
            "16:9",
            "4:3",
            "custom"
          ]
        },
        "output_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pptx",
              "pdf",
              "svg",
              "png",
              "html",
              "artifacts_only"
            ]
          }
        },
        "editability_target": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "brand_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_content": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_user_sources",
        "external_research",
        "citation_required"
      ],
      "properties": {
        "use_user_sources": {
          "type": "boolean"
        },
        "external_research": {
          "type": "boolean"
        },
        "citation_required": {
          "type": "boolean"
        },
        "freshness_requirement": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowed_source_tiers": {
          "type": "array",
          "items": {
            "enum": [
              "user",
              "primary",
              "secondary",
              "community",
              "inference",
              "assumption"
            ]
          }
        }
      }
    },
    "approval_mode": {
      "enum": [
        "auto",
        "checkpoint",
        "strict"
      ]
    },
    "quality_profile": {
      "enum": [
        "draft",
        "standard",
        "critical"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "statement",
          "status"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^ASM-[0-9]{3}$"
          },
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "accepted",
              "rejected"
            ]
          },
          "field_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "basis": {"type": "string"},
          "risk": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "engine",
        "engine_version",
        "completed_at",
        "input_hash",
        "context_hash",
        "result_hash",
        "resolved_fields",
        "inferred_fields",
        "question_ids",
        "assumption_ids"
      ],
      "properties": {
        "status": {"enum": ["resolved", "needs_input"]},
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "format": "date-time"},
        "input_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "context_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "result_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "resolved_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "inferred_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "question_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^Q-[0-9]{3}$"}
        },
        "assumption_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ASM-[0-9]{3}$"}
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "question",
          "blocking",
          "status"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^Q-[0-9]{3}$"
          },
          "question": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "answered",
              "waived"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "field_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
