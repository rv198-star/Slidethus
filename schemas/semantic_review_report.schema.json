{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/semantic-review-report.schema.json",
  "title": "Semantic Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "report_id", "review_mode", "provider",
    "capability", "deterministic_review", "inputs", "issues", "summary",
    "status", "target_phase"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "report_id": {"type": "string", "pattern": "^SVR-[A-F0-9]{16}$"},
    "review_mode": {"const": "open_issue"},
    "provider": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "capability": {"$ref": "#/$defs/capability"},
    "deterministic_review": {"$ref": "#/$defs/runtimeRef"},
    "inputs": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_count", "major_count", "minor_count", "open_count"],
      "properties": {
        "critical_count": {"type": "integer", "minimum": 0},
        "major_count": {"type": "integer", "minimum": 0},
        "minor_count": {"type": "integer", "minimum": 0},
        "open_count": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["pass", "issues", "blocked"]},
    "target_phase": {
      "type": ["string", "null"],
      "enum": [null, "CREATED", "BRIEF_READY", "SOURCES_READY", "EVIDENCE_READY", "NARRATIVE_READY", "OUTLINE_READY", "SLIDE_SPECS_READY", "DRAFT_RENDERED"]
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": {"enum": ["available", "missing"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "runtimeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "path", "sha256", "status"],
      "properties": {
        "review_id": {"type": "string", "pattern": "^DVR-[A-F0-9]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["pass", "issues"]}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id", "code", "severity", "status", "artifact_type", "slide_id",
        "block_id", "region_id", "earliest_phase", "finding", "impact",
        "evidence_ids", "recommended_fix", "verification", "repairability"
      ],
      "properties": {
        "issue_id": {"type": "string", "pattern": "^SRI-[A-F0-9]{16}$"},
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
        "severity": {"enum": ["critical", "major", "minor"]},
        "status": {"const": "open"},
        "artifact_type": {
          "enum": ["project_brief", "source_ledger", "evidence_ledger", "narrative_blueprint", "deck_outline", "slide_specs", "layout_plans"]
        },
        "slide_id": {"type": ["string", "null"], "pattern": "^S-[0-9]{3}$"},
        "block_id": {"type": ["string", "null"], "pattern": "^BLK-S[0-9]{3}-[0-9]{2}$"},
        "region_id": {"type": ["string", "null"], "pattern": "^REG-S[0-9]{3}-[0-9]{2}$"},
        "earliest_phase": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5A", "P5B", "P8"]},
        "finding": {"type": "string", "minLength": 1, "maxLength": 4000},
        "impact": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^EVD-[0-9]{3}$"}
        },
        "recommended_fix": {"type": "string", "minLength": 1, "maxLength": 4000},
        "verification": {"type": "string", "minLength": 1, "maxLength": 4000},
        "repairability": {"enum": ["automatic", "assisted", "manual"]}
      }
    }
  }
}
