{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/visual-review-report.schema.json",
  "title": "Visual Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "report_id", "review_mode", "provider", "capability",
    "deterministic_review", "semantic_review", "semantic_scorecard", "image_set", "issues",
    "summary", "status", "target_phase"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "report_id": {"type": "string", "pattern": "^VVR-[A-F0-9]{16}$"},
    "review_mode": {"const": "full_page_visual"},
    "provider": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "detail", "office_preview_status"],
      "properties": {
        "status": {"enum": ["available", "missing"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
        "office_preview_status": {"enum": ["available", "missing"]}
      }
    },
    "deterministic_review": {"$ref": "#/$defs/runtimeRefD"},
    "semantic_review": {"$ref": "#/$defs/runtimeRefS"},
    "semantic_scorecard": {"$ref": "#/$defs/runtimeRefC"},
    "image_set": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slide_id", "path", "sha256", "kind", "source_output"],
        "properties": {
          "slide_id": {"type": "string", "pattern": "^S-[0-9]{3}$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "kind": {"enum": ["final_svg_png", "office_preview"]},
          "source_output": {"type": ["string", "null"]}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "issue_id", "code", "severity", "status", "slide_id", "related_slide_ids",
          "region_id", "earliest_phase", "finding", "impact", "recommended_fix",
          "verification", "repairability"
        ],
        "properties": {
          "issue_id": {"type": "string", "pattern": "^VRI-[A-F0-9]{16}$"},
          "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
          "severity": {"enum": ["critical", "major", "minor"]},
          "status": {"const": "open"},
          "slide_id": {"type": ["string", "null"], "pattern": "^S-[0-9]{3}$"},
          "related_slide_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^S-[0-9]{3}$"}
          },
          "region_id": {"type": ["string", "null"], "pattern": "^REG-S[0-9]{3}-[0-9]{2}$"},
          "earliest_phase": {"enum": ["P5A", "P5B", "P6", "P7"]},
          "finding": {"type": "string", "minLength": 1, "maxLength": 4000},
          "impact": {"type": "string", "minLength": 1, "maxLength": 4000},
          "recommended_fix": {"type": "string", "minLength": 1, "maxLength": 4000},
          "verification": {"type": "string", "minLength": 1, "maxLength": 4000},
          "repairability": {"enum": ["automatic", "assisted", "manual"]}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["critical_count", "major_count", "minor_count", "open_count", "page_count", "office_page_count"],
      "properties": {
        "critical_count": {"type": "integer", "minimum": 0},
        "major_count": {"type": "integer", "minimum": 0},
        "minor_count": {"type": "integer", "minimum": 0},
        "open_count": {"type": "integer", "minimum": 0},
        "page_count": {"type": "integer", "minimum": 1},
        "office_page_count": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["pass", "issues", "blocked"]},
    "target_phase": {
      "type": ["string", "null"],
      "enum": [null, "OUTLINE_READY", "SLIDE_SPECS_READY", "LAYOUT_READY", "VISUAL_SYSTEM_READY"]
    }
  },
  "$defs": {
    "runtimeRefD": {
      "type": "object", "additionalProperties": false,
      "required": ["review_id", "path", "sha256", "status"],
      "properties": {
        "review_id": {"type": "string", "pattern": "^DVR-[A-F0-9]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["pass", "issues"]}
      }
    },
    "runtimeRefS": {
      "type": "object", "additionalProperties": false,
      "required": ["report_id", "path", "sha256", "status"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^SVR-[A-F0-9]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["pass", "issues", "blocked"]}
      }
    },
    "runtimeRefC": {
      "type": "object", "additionalProperties": false,
      "required": ["report_id", "path", "sha256", "status"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^SCR-[A-F0-9]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["pass", "issues", "blocked"]}
      }
    }
  }
}
