{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/review-repair-report.schema.json",
  "title": "Review Repair Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "repair_id", "plan", "before_inputs", "after_inputs",
    "actions", "result_deterministic", "changed_artifacts", "changed_slides",
    "remaining_source_ids", "rerendered", "status"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "repair_id": {"type": "string", "pattern": "^RRR-[A-F0-9]{16}$"},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "path", "sha256", "status"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^RPL-[A-F0-9]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["planned", "not_required"]}
      }
    },
    "before_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
    "after_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
    "actions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operation", "status", "detail"],
        "properties": {
          "operation": {"type": "string", "minLength": 1},
          "status": {"enum": ["complete", "blocked", "failed", "skipped"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "result_deterministic": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["review_id", "path", "sha256", "status"],
      "properties": {
        "review_id": {"type": "string", "pattern": "^DVR-[A-F0-9]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["pass", "issues"]}
      }
    },
    "changed_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "changed_slides": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^S-[0-9]{3}$"}},
    "remaining_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "rerendered": {"type": "boolean"},
    "status": {"enum": ["applied", "blocked", "not_required", "failed"]}
  },
  "$defs": {
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
