{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/narrative-blueprint.schema.json",
  "title": "Narrative Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "central_thesis",
    "story_arc",
    "audience_journey",
    "sections",
    "objections",
    "excluded_content"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "central_thesis": {
      "type": "string",
      "minLength": 1
    },
    "story_rationale": {
      "type": "string",
      "minLength": 1
    },
    "proof_strategy": {
      "type": "string",
      "minLength": 1
    },
    "call_to_action": {
      "type": "string"
    },
    "status": {
      "enum": ["draft", "reviewed", "approved", "frozen"]
    },
    "story_arc": {
      "enum": [
        "problem-solution-proof-action",
        "situation-complication-resolution",
        "why-what-how",
        "chronological",
        "question-answer",
        "portfolio",
        "teaching",
        "custom"
      ]
    },
    "audience_journey": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "title",
          "purpose",
          "key_questions",
          "evidence_ids",
          "transition"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^SEC-[0-9]{2}$"
          },
          "ordinal": {"type": "integer", "minimum": 1},
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "key_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EVD-[0-9]{3}$"
            }
          },
          "transition": {
            "type": "string"
          },
          "thesis": {"type": "string"},
          "audience_shift": {"type": "string"},
          "proof_strategy": {"type": "string"},
          "slide_budget": {"type": "integer", "minimum": 1},
          "status": {"enum": ["draft", "approved", "excluded"]}
        }
      }
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objection",
          "response_strategy"
        ],
        "properties": {
          "objection_id": {
            "type": "string",
            "pattern": "^OBJ-[0-9]{3}$"
          },
          "objection": {
            "type": "string"
          },
          "response_strategy": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EVD-[0-9]{3}$"
            }
          },
          "audience_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^AUD-[0-9]{2}$"}
          },
          "severity": {"enum": ["critical", "high", "medium", "low"]}
        }
      }
    },
    "excluded_content": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "planning_lineage": {"$ref": "#/$defs/planningLineage"}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "semantic_scope": {"enum": ["claims"]},
        "semantic_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "planningLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id",
        "engine",
        "engine_version",
        "provider",
        "generated_at",
        "proposal_hash",
        "policy",
        "policy_hash",
        "input_refs",
        "warnings",
        "assumptions"
      ],
      "properties": {
        "lineage_id": {"type": "string", "pattern": "^PLN-[A-F0-9]{16}$"},
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "generated_at": {"type": "string", "format": "date-time"},
        "proposal_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "limits"],
          "properties": {
            "service": {"enum": ["narrative", "outline", "slide_specs", "layout"]},
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_blocking_questions", "max_assumptions", "max_sections", "max_slides",
                "max_blocks_per_slide", "max_words_per_slide", "max_provider_payload_bytes",
                "max_change_targets"
              ],
              "properties": {
                "max_blocking_questions": {"type": "integer", "minimum": 1},
                "max_assumptions": {"type": "integer", "minimum": 1},
                "max_sections": {"type": "integer", "minimum": 1},
                "max_slides": {"type": "integer", "minimum": 1},
                "max_blocks_per_slide": {"type": "integer", "minimum": 1},
                "max_words_per_slide": {"type": "integer", "minimum": 1},
                "max_provider_payload_bytes": {"type": "integer", "minimum": 1},
                "max_change_targets": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "policy_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "input_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifactRef"}
        },
        "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
