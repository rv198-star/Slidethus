{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/source-snapshot.schema.json",
  "title": "Source Parse Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_id",
    "source_sha256",
    "size_bytes",
    "created_at",
    "detected_format",
    "parser",
    "limits",
    "chunks",
    "warnings",
    "risks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[0-9]{3}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "detected_format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "media_type",
        "suffix",
        "signature",
        "confidence"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "suffix": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_bytes",
        "max_chunks",
        "max_chunk_chars"
      ],
      "properties": {
        "max_source_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_chunks": {
          "type": "integer",
          "minimum": 1
        },
        "max_chunk_chars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "ordinal",
          "locator",
          "text",
          "content_hash",
          "kind",
          "metadata"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^CHK-SRC-[0-9]{3}-[0-9]{4}-[A-F0-9]{8}$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk_id",
          "category",
          "severity",
          "message",
          "locator"
        ],
        "properties": {
          "risk_id": {
            "type": "string",
            "pattern": "^RSK-SRC-[0-9]{3}-[0-9]{3}$"
          },
          "category": {
            "enum": [
              "prompt_injection",
              "active_content",
              "external_link",
              "encoding",
              "oversized",
              "other"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "high"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
