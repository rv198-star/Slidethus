{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/art-direction-seed.schema.json",
  "title": "Art Direction Seed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seed_id",
    "project_id",
    "deck_id",
    "status",
    "provider",
    "design_read",
    "dials",
    "foundation",
    "direction",
    "input_lineage",
    "generated_at",
    "warnings",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "seed_id": {
      "type": "string",
      "pattern": "^ADS-[A-F0-9]{16}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "deck_id": {
      "type": "string",
      "pattern": "^DECK-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "status": {
      "const": "frozen"
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "design_read": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "dials": {
      "$ref": "#/$defs/dials"
    },
    "foundation": {
      "oneOf": [
        {
          "$ref": "#/$defs/resourceOnlyFoundation"
        },
        {
          "$ref": "#/$defs/tasteInformedFoundation"
        },
        {
          "$ref": "#/$defs/tasteGeneratedFoundation"
        }
      ]
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carriers",
        "image_direction",
        "deck_rhythm",
        "surface_rhythm",
        "forbidden_patterns"
      ],
      "properties": {
        "carriers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 120,
          "items": {
            "$ref": "#/$defs/carrier"
          }
        },
        "image_direction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "style",
            "fit",
            "missing_asset",
            "prompt_keywords"
          ],
          "properties": {
            "style": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "fit": {
              "enum": [
                "cover",
                "contain"
              ]
            },
            "missing_asset": {
              "enum": [
                "fail",
                "replan"
              ]
            },
            "prompt_keywords": {
              "type": "array",
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "deck_rhythm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "surface_rhythm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_consecutive_plain"
          ],
          "properties": {
            "max_consecutive_plain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          }
        },
        "forbidden_patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "input_lineage": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "warnings": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "mode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "upstream_url",
            "upstream_commit",
            "license"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[^/].*"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "upstream_url": {
              "type": "string",
              "format": "uri"
            },
            "upstream_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "license": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "dials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_variance",
        "motion_intensity",
        "visual_density"
      ],
      "properties": {
        "design_variance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "motion_intensity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "visual_density": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "resourceOnlyFoundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "resource-only"
        }
      }
    },
    "tasteInformedFoundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "taste-informed"
        }
      }
    },
    "tasteGeneratedFoundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prototype"
      ],
      "properties": {
        "kind": {
          "const": "taste-generated"
        },
        "prototype": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "medium",
            "path",
            "content_hash"
          ],
          "properties": {
            "medium": {
              "enum": [
                "html-css",
                "svg",
                "image"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slide_id",
        "kind",
        "requirement",
        "surface_treatment",
        "rationale"
      ],
      "properties": {
        "slide_id": {
          "type": "string",
          "pattern": "^S-[0-9]{3}$"
        },
        "kind": {
          "enum": [
            "textual",
            "typographic",
            "image",
            "chart",
            "diagram",
            "table"
          ]
        },
        "requirement": {
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "surface_treatment": {
          "enum": [
            "plain",
            "tonal",
            "field",
            "image-led"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "version",
        "content_hash"
      ],
      "properties": {
        "artifact_type": {
          "enum": [
            "project_brief",
            "deck_outline"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
