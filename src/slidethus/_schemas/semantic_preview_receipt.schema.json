{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/semantic-preview-receipt.schema.json",
  "title": "Semantic Planning Preview Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "receipt_id", "generated_at", "producer",
    "inputs", "seed_ref", "target_capability", "pages"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "receipt_id": {"type": "string", "pattern": "^SPR-[A-F0-9]{16}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "semantic-planning-preview"},
        "version": {"const": "1.0.0"}
      }
    },
    "inputs": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "seed_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["seed_id", "path", "content_hash"],
      "properties": {
        "seed_id": {"type": "string", "pattern": "^ADS-[A-F0-9]{16}$"},
        "path": {"type": "string", "pattern": "^\\.slidethus/art-direction/seeds/[a-f0-9]{64}\\.json$"},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "target_capability": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "contract_version", "contract_hash"],
      "properties": {
        "backend": {"const": "artifact-tool"},
        "contract_version": {"const": "2.0.0"},
        "contract_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slide_id", "representation_id", "path", "sha256", "mime_type"],
        "properties": {
          "slide_id": {"type": "string", "pattern": "^S-[0-9]{3}$"},
          "representation_id": {"type": "string", "pattern": "^REP-S[0-9]{3}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "mime_type": {"const": "image/svg+xml"}
        }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {"enum": ["project_brief", "deck_outline", "slide_specs", "layout_plans"]},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
