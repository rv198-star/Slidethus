{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/renderer-ir.schema.json",
  "title": "Renderer Intermediate Representation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "deck_id", "ir_id", "generated_at",
    "input_artifacts", "canvas", "safe_area", "slides", "fonts", "font_substitutions", "asset_ids", "warnings"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.[12]\\.[0-9]+$"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "deck_id": {"type": "string", "pattern": "^DECK-[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "ir_id": {"type": "string", "pattern": "^RIR-[A-F0-9]{16}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "input_artifacts": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "producer_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "contract_version", "capability_id", "contract_hash"],
      "properties": {
        "backend": {"const": "artifact-tool"},
        "contract_version": {"const": "2.0.0"},
        "capability_id": {"const": "artifact-tool-closed-grammar-v2"},
        "contract_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "slidethus-render-compile"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": {"type": "integer", "minimum": 100},
        "height": {"type": "integer", "minimum": 100},
        "background": {"type": "string", "minLength": 1}
      }
    },
    "safe_area": {"$ref": "#/$defs/boxInsets"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_id", "ordinal", "layout_family", "regions", "decorations"],
        "properties": {
          "background": {"type": "string", "pattern": "^#[a-fA-F0-9]{6}$"},
          "slide_id": {"type": "string", "pattern": "^S-[0-9]{3}$"},
          "ordinal": {"type": "integer", "minimum": 1},
          "layout_family": {"type": "string", "minLength": 1},
          "page_family_id": {"type": "string", "pattern": "^family-[a-z0-9-]{2,63}$"},
          "component_variant_id": {"type": "string", "pattern": "^variant-[a-z0-9-]{2,63}$"},
          "representation_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["representation_id", "content_hash"],
            "properties": {
              "representation_id": {"type": "string", "pattern": "^REP-S[0-9]{3}$"},
              "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          },
          "focal_order": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^REG-S[0-9]{3}-[0-9]{2}$"}
          },
          "view": {"type": "object"},
          "consumption_trace": {"$ref": "#/$defs/consumptionTrace"},
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/region"}
          },
          "decorations": {
            "type": "array",
            "items": {"$ref": "#/$defs/decoration"}
          }
        }
      }
    },
    "fonts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "font_substitutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requested", "actual", "status", "reason"],
        "properties": {
          "requested": {"type": "string", "minLength": 1},
          "actual": {"type": "string", "minLength": 1},
          "status": {"enum": ["available", "substituted"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "asset_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AST-[0-9]{3}$"}
    },
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 4000}}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"pattern": "^0\\.2\\."}}},
      "then": {
        "required": ["producer_capability", "compiler"],
        "properties": {
          "slides": {
            "items": {
              "required": [
                "page_family_id", "component_variant_id", "representation_ref",
                "focal_order", "view", "consumption_trace"
              ],
              "properties": {
                "regions": {
                  "items": {
                    "required": ["style_id", "representation_id", "render_options", "consumption_trace"]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "consumptionTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_ids", "output_ids"],
      "properties": {
        "decision_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "output_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {
          "enum": ["project_brief", "asset_manifest", "deck_outline", "slide_specs", "layout_plans", "visual_system"]
        },
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "boxInsets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": {"type": "number", "minimum": 0},
        "right": {"type": "number", "minimum": 0},
        "bottom": {"type": "number", "minimum": 0},
        "left": {"type": "number", "minimum": 0}
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font_family", "font_size", "font_weight", "line_height", "color", "fill", "border_color", "border_width"],
      "properties": {
        "italic": {"type":"boolean"},
        "corner_radius": {"type":"number","minimum":0},
        "image_fit": {"enum":["cover","contain"]},
        "chart_colors": {"type":"array","minItems":1,"items":{"type":"string","pattern":"^#[a-fA-F0-9]{6}$"}},
        "font_family": {"type": "string", "minLength": 1},
        "font_size": {"type": "number", "minimum": 1},
        "font_weight": {"type": "integer", "minimum": 100, "maximum": 900},
        "line_height": {"type": "number", "minimum": 0.5},
        "color": {"type": "string", "minLength": 1},
        "fill": {"type": ["string", "null"]},
        "border_color": {"type": ["string", "null"]},
        "border_width": {"type": "number", "minimum": 0}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id", "block_id", "semantic_role", "content_type", "priority", "content",
        "claim_mode", "evidence_qualification", "evidence_ids", "asset_refs", "x", "y", "w", "h", "z", "align", "valign",
        "overflow_strategy", "style"
      ],
      "properties": {
        "region_id": {"type": "string", "pattern": "^REG-S[0-9]{3}-[0-9]{2}$"},
        "block_id": {"type": "string", "pattern": "^BLK-S[0-9]{3}-[0-9]{2}$"},
        "style_id": {"type": "string", "pattern": "^style-[a-z0-9-]{2,63}$"},
        "representation_id": {"type": "string", "pattern": "^REP-S[0-9]{3}$"},
        "render_options": {"type": "object"},
        "consumption_trace": {"$ref": "#/$defs/consumptionTrace"},
        "semantic_role": {"type": "string", "minLength": 1},
        "content_type": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "minLength": 1},
        "content": {},
        "claim_mode": {"enum": ["label", "fact", "interpretation", "instruction", "asset"]},
        "evidence_qualification": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[0-9]{3}$"}},
        "asset_refs": {"type": "array", "items": {"type": "string", "pattern": "^AST-[0-9]{3}$"}},
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0},
        "z": {"type": "integer", "minimum": 0},
        "align": {"enum": ["left", "center", "right"]},
        "valign": {"enum": ["top", "middle", "bottom"]},
        "overflow_strategy": {"enum": ["fail", "wrap", "shrink_with_floor", "clip", "paginate"]},
        "style": {"$ref": "#/$defs/style"}
      }
    },
    "decoration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decoration_id", "kind", "x", "y", "w", "h", "fill", "stroke", "z"],
      "properties": {
        "decoration_id": {"type": "string", "pattern": "^DEC-S[0-9]{3}-[0-9]{2}$"},
        "kind": {"enum": ["rect", "round_rect", "ellipse", "line"]},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "w": {"type": "number", "minimum": 0},
        "h": {"type": "number", "minimum": 0},
        "fill": {"type": ["string", "null"]},
        "stroke": {"type": ["string", "null"]},
        "z": {"type": "integer"}
      }
    }
  }
}
