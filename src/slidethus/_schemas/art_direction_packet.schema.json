{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/art-direction-packet.schema.json",
  "title": "Art Direction Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "project_id",
    "deck_id",
    "status",
    "provider",
    "design_read",
    "dials",
    "direction",
    "input_lineage",
    "generated_at",
    "warnings",
    "assumptions"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "packet_id": {"type": "string", "pattern": "^ADP-[A-F0-9]{16}$"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "deck_id": {"type": "string", "pattern": "^DECK-[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "status": {"const": "frozen"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mode"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "mode": {"type": "string", "minLength": 1, "maxLength": 128},
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "upstream_url", "upstream_commit", "license"],
          "properties": {
            "path": {"type": "string", "pattern": "^[^/].*"},
            "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "upstream_url": {"type": "string", "format": "uri"},
            "upstream_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "license": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "design_read": {"type": "string", "minLength": 1, "maxLength": 600},
    "dials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_variance", "motion_intensity", "visual_density"],
      "properties": {
        "design_variance": {"type": "integer", "minimum": 1, "maximum": 10},
        "motion_intensity": {"type": "integer", "minimum": 1, "maximum": 10},
        "visual_density": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_id",
        "tone",
        "palette",
        "typography",
        "composition",
        "image_direction",
        "forbidden_patterns"
      ],
      "properties": {
        "page_designs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 120,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slide_id",
              "background",
              "regions",
              "decorations"
            ],
            "properties": {
              "slide_id": {
                "type": "string",
                "pattern": "^S-[0-9]{3}$"
              },
              "surface_treatment": {
                "enum": ["plain", "tonal", "field", "image-led"]
              },
              "background": {
                "type": "string",
                "pattern": "^#[a-fA-F0-9]{6}$"
              },
              "regions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "block_id",
                    "style"
                  ],
                  "properties": {
                    "block_id": {
                      "type": "string",
                      "pattern": "^BLK-S[0-9]{3}-[0-9]{2}$"
                    },
                    "style": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "font_family",
                        "font_size",
                        "font_weight",
                        "line_height",
                        "color",
                        "fill",
                        "border_color",
                        "border_width"
                      ],
                      "properties": {
                        "font_family": {
                          "type": "string",
                          "minLength": 1
                        },
                        "font_size": {
                          "type": "number",
                          "minimum": 1
                        },
                        "font_weight": {
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 900
                        },
                        "line_height": {
                          "type": "number",
                          "minimum": 0.5
                        },
                        "color": {
                          "type": "string",
                          "minLength": 1
                        },
                        "fill": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "border_color": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "border_width": {
                          "type": "number",
                          "minimum": 0
                        },
                        "italic": {
                          "type": "boolean"
                        },
                        "corner_radius": {
                          "type": "number",
                          "minimum": 0
                        },
                        "image_fit": {
                          "enum": [
                            "cover",
                            "contain"
                          ]
                        },
                        "chart_colors": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "pattern": "^#[a-fA-F0-9]{6}$"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "decorations": {
                "type": "array",
                "maxItems": 99,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "decoration_id",
                    "kind",
                    "x",
                    "y",
                    "w",
                    "h",
                    "fill",
                    "stroke",
                    "z"
                  ],
                  "properties": {
                    "decoration_id": {
                      "type": "string",
                      "pattern": "^DEC-S[0-9]{3}-[0-9]{2}$"
                    },
                    "kind": {
                      "enum": [
                        "rect",
                        "round_rect",
                        "ellipse",
                        "line"
                      ]
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0
                    },
                    "fill": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "stroke": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "z": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "theme_id": {"type": "string", "pattern": "^THEME-[A-Z0-9][A-Z0-9_-]{2,63}$"},
        "tone": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "palette": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
          "required": [
            "background",
            "surface",
            "text_primary",
            "text_secondary",
            "primary",
            "accent",
            "surface_muted",
            "primary_soft",
            "accent_soft"
          ]
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preferred_font",
            "fallbacks",
            "display_size",
            "title_size",
            "body_size",
            "caption_size"
          ],
          "properties": {
            "preferred_font": {"type": "string", "minLength": 1},
            "fallbacks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "display_size": {"type": "number", "minimum": 1},
            "title_size": {"type": "number", "minimum": 1},
            "body_size": {"type": "number", "minimum": 1},
            "caption_size": {"type": "number", "minimum": 1}
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "corner_radius",
            "region_gap",
            "max_same_family_consecutive",
            "max_bento_ratio",
            "min_gap",
            "page_role_treatments",
            "component_variants",
            "deck_rhythm",
            "variation_rule"
          ],
          "properties": {
            "corner_radius": {"type": "number", "minimum": 0},
            "region_gap": {"type": "number", "minimum": 0},
            "max_same_family_consecutive": {"type": "integer", "minimum": 1},
            "max_bento_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "min_gap": {"type": "number", "minimum": 0},
            "page_role_treatments": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string", "minLength": 1}
            },
            "component_variants": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "deck_rhythm": {"type": "string", "minLength": 1},
            "variation_rule": {"type": "string", "minLength": 1}
          }
        },
        "image_direction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "fit", "missing_asset"],
          "properties": {
            "style": {"type": "string", "minLength": 1},
            "fit": {"enum": ["cover", "contain"]},
            "missing_asset": {"enum": ["fail", "degrade", "omit"]},
            "prompt_keywords": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "forbidden_patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "pre_layout_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_id", "path", "content_hash", "provider"],
      "properties": {
        "seed_id": {"type": "string", "pattern": "^ADS-[A-F0-9]{16}$"},
        "path": {"type": "string", "pattern": "^\\.slidethus/art-direction/seeds/[a-f0-9]{64}\\.json$"},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "mode"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "mode": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      }
    },
    "input_lineage": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "version", "content_hash"],
        "properties": {
          "artifact_type": {
            "enum": ["project_brief", "deck_outline", "slide_specs", "layout_plans", "asset_manifest"]
          },
          "version": {"type": "integer", "minimum": 1},
          "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  }
}
