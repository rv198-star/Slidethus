{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/render-preflight-report.schema.json",
  "title": "Render Preflight Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "preflight_id", "generated_at", "status",
    "renderer_ir", "backends", "capabilities", "fonts", "assets", "checks", "summary"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "preflight_id": {"type": "string", "pattern": "^RPF-[A-F0-9]{16}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "blocked"]},
    "renderer_ir": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ir_id", "path", "sha256"],
      "properties": {
        "ir_id": {"type": "string", "pattern": "^RIR-[A-F0-9]{16}$"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "backends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["final-svg", "pptxgenjs-native", "pptxgenjs-hybrid", "artifact-tool"]}
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "status", "detail"],
        "properties": {
          "capability": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"enum": ["available", "missing", "degraded"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requested", "actual", "status", "reason"],
        "properties": {
          "requested": {"type": "string", "minLength": 1},
          "actual": {"type": "string", "minLength": 1},
          "status": {"enum": ["available", "substituted"]},
          "reason": {"type": "string", "minLength": 1},
          "file_path": {"type": ["string", "null"], "maxLength": 4096}
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "kind", "path", "sha256", "media_type", "editable_as"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^AST-[0-9]{3}$"},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "editable_as": {"type": "string", "minLength": 1}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id", "code", "status", "severity", "backend", "slide_id",
          "block_id", "region_id", "message"
        ],
        "properties": {
          "check_id": {"type": "string", "pattern": "^RPC-[A-F0-9]{16}$"},
          "code": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"enum": ["pass", "fail"]},
          "severity": {"enum": ["info", "minor", "major", "critical"]},
          "backend": {"type": ["string", "null"]},
          "slide_id": {"type": ["string", "null"], "pattern": "^S-[0-9]{3}$"},
          "block_id": {"type": ["string", "null"], "pattern": "^BLK-S[0-9]{3}-[0-9]{2}$"},
          "region_id": {"type": ["string", "null"], "pattern": "^REG-S[0-9]{3}-[0-9]{2}$"},
          "asset_id": {"type": "string", "pattern": "^AST-[0-9]{3}$"},
          "message": {"type": "string", "minLength": 1, "maxLength": 4000},
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required_height", "available_height", "required_height_increase",
              "width", "preferred_font_pt", "floor_font_pt", "fitted_font_pt",
              "line_height", "line_count", "qualification_reserve", "failure_reason"
            ],
            "properties": {
              "required_height": {"type": "number", "minimum": 0},
              "available_height": {"type": "number", "minimum": 0},
              "required_height_increase": {"type": "number", "minimum": 0},
              "width": {"type": "number", "exclusiveMinimum": 0},
              "preferred_font_pt": {"type": "number", "exclusiveMinimum": 0},
              "floor_font_pt": {"type": "number", "exclusiveMinimum": 0},
              "fitted_font_pt": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "line_height": {"type": "number", "exclusiveMinimum": 0},
              "line_count": {"type": "integer", "minimum": 0},
              "qualification_reserve": {"type": "number", "minimum": 0},
              "horizontal_padding": {"type": "number", "minimum": 0},
              "vertical_padding": {"type": "number", "minimum": 0},
              "failure_reason": {
                "type": ["string", "null"],
                "enum": [null, "required_height_exceeds_available_at_floor"]
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_count", "major_count", "minor_count", "failed_count"],
      "properties": {
        "critical_count": {"type": "integer", "minimum": 0},
        "major_count": {"type": "integer", "minimum": 0},
        "minor_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
