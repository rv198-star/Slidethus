{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/evidence-ledger.schema.json",
  "title": "Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "research_cycles",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "claim",
          "support_status",
          "source_refs",
          "use_policy"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EVD-[0-9]{3}$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "support_status": {
            "enum": [
              "verified",
              "provisional",
              "disputed",
              "unsupported",
              "inference",
              "assumption"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator",
                "support_type"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^SRC-[0-9]{3}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "support_type": {
                  "enum": [
                    "direct",
                    "indirect",
                    "context"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "freshness_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "conflict_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "use_policy": {
            "enum": [
              "allowed_with_citation",
              "allowed_with_qualification",
              "internal_only",
              "do_not_use"
            ]
          },
          "reasoning": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "research_cycles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cycle_id",
          "kind",
          "status",
          "basis",
          "outline_version",
          "source_ids",
          "notes",
          "query_count",
          "waiver_reason"
        ],
        "properties": {
          "cycle_id": {
            "type": "string",
            "pattern": "^RSC-[0-9]{3}$"
          },
          "kind": {
            "enum": [
              "orientation",
              "targeted"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "complete",
              "waived",
              "blocked"
            ]
          },
          "basis": {
            "enum": [
              "user_materials",
              "external_research",
              "mixed",
              "none_required"
            ]
          },
          "outline_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SRC-[0-9]{3}$"
            }
          },
          "query_count": {
            "type": "integer",
            "minimum": 0
          },
          "waiver_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "orientation"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "outline_version": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "targeted"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "outline_version": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "waived"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "waiver_reason"
              ],
              "properties": {
                "waiver_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "complete"
                },
                "basis": {
                  "not": {
                    "const": "none_required"
                  }
                }
              },
              "required": [
                "status",
                "basis"
              ]
            },
            "then": {
              "properties": {
                "source_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
