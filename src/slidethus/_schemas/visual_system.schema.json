{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/visual-system.schema.json",
  "title": "Visual System",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "deck_id",
    "theme_id",
    "tone",
    "canvas",
    "colors",
    "typography",
    "spacing",
    "shape_rules",
    "layout_policy",
    "forbidden_patterns",
    "font_fallbacks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "deck_id": {
      "type": "string",
      "pattern": "^DECK-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "theme_id": {
      "type": "string",
      "pattern": "^THEME-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "tone": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "aspect_ratio"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "aspect_ratio": {
          "type": "string"
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "background",
        "surface",
        "text_primary",
        "text_secondary",
        "primary",
        "accent"
      ]
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "title",
        "body",
        "caption"
      ],
      "properties": {
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font_family",
            "font_size",
            "font_weight",
            "line_height",
            "color"
          ],
          "properties": {
            "font_family": {
              "type": "string"
            },
            "font_size": {
              "type": "number",
              "minimum": 1
            },
            "font_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "line_height": {
              "type": "number",
              "minimum": 0.5
            },
            "color": {
              "type": "string"
            },
            "letter_spacing": {
              "type": "number"
            }
          }
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font_family",
            "font_size",
            "font_weight",
            "line_height",
            "color"
          ],
          "properties": {
            "font_family": {
              "type": "string"
            },
            "font_size": {
              "type": "number",
              "minimum": 1
            },
            "font_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "line_height": {
              "type": "number",
              "minimum": 0.5
            },
            "color": {
              "type": "string"
            },
            "letter_spacing": {
              "type": "number"
            }
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font_family",
            "font_size",
            "font_weight",
            "line_height",
            "color"
          ],
          "properties": {
            "font_family": {
              "type": "string"
            },
            "font_size": {
              "type": "number",
              "minimum": 1
            },
            "font_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "line_height": {
              "type": "number",
              "minimum": 0.5
            },
            "color": {
              "type": "string"
            },
            "letter_spacing": {
              "type": "number"
            }
          }
        },
        "caption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font_family",
            "font_size",
            "font_weight",
            "line_height",
            "color"
          ],
          "properties": {
            "font_family": {
              "type": "string"
            },
            "font_size": {
              "type": "number",
              "minimum": 1
            },
            "font_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "line_height": {
              "type": "number",
              "minimum": 0.5
            },
            "color": {
              "type": "string"
            },
            "letter_spacing": {
              "type": "number"
            }
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "region_gap",
        "safe_area"
      ],
      "properties": {
        "base": {
          "type": "number",
          "minimum": 1
        },
        "region_gap": {
          "type": "number",
          "minimum": 0
        },
        "safe_area": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "properties": {
            "top": {
              "type": "number"
            },
            "right": {
              "type": "number"
            },
            "bottom": {
              "type": "number"
            },
            "left": {
              "type": "number"
            }
          }
        }
      }
    },
    "shape_rules": {
      "type": "object",
      "additionalProperties": true
    },
    "chart_rules": {
      "type": "object"
    },
    "image_rules": {
      "type": "object"
    },
    "icon_rules": {
      "type": "object"
    },
    "layout_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_same_family_consecutive",
        "max_bento_ratio",
        "min_gap"
      ],
      "properties": {
        "max_same_family_consecutive": {
          "type": "integer",
          "minimum": 1
        },
        "max_bento_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_gap": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "forbidden_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "font_fallbacks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "brand_assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AST-[0-9]{3}$"
      }
    },
    "art_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "path", "content_hash", "provider"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^ADP-[A-F0-9]{16}$"},
        "path": {
          "type": "string",
          "pattern": "^\\.slidethus/art-direction/packets/[a-f0-9]{64}\\.json$"
        },
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "mode"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "mode": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "render_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engine_version", "generated_at", "inputs"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "inputs": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_type", "version", "content_hash"],
            "properties": {
              "artifact_type": {
                "enum": ["project_brief", "deck_outline", "slide_specs", "layout_plans", "asset_manifest"]
              },
              "version": {"type": "integer", "minimum": 1},
              "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  }
}
