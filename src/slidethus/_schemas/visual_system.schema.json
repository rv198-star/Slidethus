{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/visual-system.schema.json",
  "title": "Visual System",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "deck_id",
    "theme_id",
    "tone",
    "canvas",
    "colors",
    "typography",
    "spacing",
    "shape_rules",
    "layout_policy",
    "forbidden_patterns",
    "font_fallbacks"
  ],
  "properties": {
    "page_designs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_id",
          "background",
          "regions",
          "decorations"
        ],
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^S-[0-9]{3}$"
          },
          "surface_treatment": {
            "enum": ["plain", "tonal", "field", "image-led"]
          },
          "page_family_id": {"type": "string", "pattern": "^family-[a-z0-9-]{2,63}$"},
          "component_variant_id": {"type": "string", "pattern": "^variant-[a-z0-9-]{2,63}$"},
          "background": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "block_id",
                "style"
              ],
              "properties": {
                "block_id": {
                  "type": "string",
                  "pattern": "^BLK-S[0-9]{3}-[0-9]{2}$"
                },
                "style_id": {"type": "string", "pattern": "^style-[a-z0-9-]{2,63}$"},
                "style": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "font_family",
                    "font_size",
                    "font_weight",
                    "line_height",
                    "color",
                    "fill",
                    "border_color",
                    "border_width"
                  ],
                  "properties": {
                    "font_family": {
                      "type": "string",
                      "minLength": 1
                    },
                    "font_size": {
                      "type": "number",
                      "minimum": 1
                    },
                    "font_weight": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 900
                    },
                    "line_height": {
                      "type": "number",
                      "minimum": 0.5
                    },
                    "color": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fill": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "border_color": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "border_width": {
                      "type": "number",
                      "minimum": 0
                    },
                    "italic": {
                      "type": "boolean"
                    },
                    "corner_radius": {
                      "type": "number",
                      "minimum": 0
                    },
                    "image_fit": {
                      "enum": [
                        "cover",
                        "contain"
                      ]
                    },
                    "chart_colors": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^#[a-fA-F0-9]{6}$"
                      }
                    }
                  }
                }
              }
            }
          },
          "decorations": {
            "type": "array",
            "maxItems": 99,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decoration_id",
                "kind",
                "x",
                "y",
                "w",
                "h",
                "fill",
                "stroke",
                "z"
              ],
              "properties": {
                "decoration_id": {
                  "type": "string",
                  "pattern": "^DEC-S[0-9]{3}-[0-9]{2}$"
                },
                "kind": {
                  "enum": [
                    "rect",
                    "round_rect",
                    "ellipse",
                    "line"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "h": {
                  "type": "number",
                  "minimum": 0
                },
                "fill": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "stroke": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "z": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.(1|2)\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "deck_id": {
      "type": "string",
      "pattern": "^DECK-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "theme_id": {
      "type": "string",
      "pattern": "^THEME-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "tone": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "aspect_ratio"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "aspect_ratio": {
          "type": "string"
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "background",
        "surface",
        "text_primary",
        "text_secondary",
        "primary",
        "accent"
      ]
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "title",
        "body",
        "caption"
      ],
      "properties": {
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font_family",
            "font_size",
            "font_weight",
            "line_height",
            "color"
          ],
          "properties": {
            "font_family": {
              "type": "string"
            },
            "font_size": {
              "type": "number",
              "minimum": 1
            },
            "font_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "line_height": {
              "type": "number",
              "minimum": 0.5
            },
            "color": {
              "type": "string"
            },
            "letter_spacing": {
              "type": "number"
            }
          }
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font_family",
            "font_size",
            "font_weight",
            "line_height",
            "color"
          ],
          "properties": {
            "font_family": {
              "type": "string"
            },
            "font_size": {
              "type": "number",
              "minimum": 1
            },
            "font_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "line_height": {
              "type": "number",
              "minimum": 0.5
            },
            "color": {
              "type": "string"
            },
            "letter_spacing": {
              "type": "number"
            }
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font_family",
            "font_size",
            "font_weight",
            "line_height",
            "color"
          ],
          "properties": {
            "font_family": {
              "type": "string"
            },
            "font_size": {
              "type": "number",
              "minimum": 1
            },
            "font_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "line_height": {
              "type": "number",
              "minimum": 0.5
            },
            "color": {
              "type": "string"
            },
            "letter_spacing": {
              "type": "number"
            }
          }
        },
        "caption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font_family",
            "font_size",
            "font_weight",
            "line_height",
            "color"
          ],
          "properties": {
            "font_family": {
              "type": "string"
            },
            "font_size": {
              "type": "number",
              "minimum": 1
            },
            "font_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "line_height": {
              "type": "number",
              "minimum": 0.5
            },
            "color": {
              "type": "string"
            },
            "letter_spacing": {
              "type": "number"
            }
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "region_gap",
        "safe_area"
      ],
      "properties": {
        "base": {
          "type": "number",
          "minimum": 1
        },
        "region_gap": {
          "type": "number",
          "minimum": 0
        },
        "safe_area": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "properties": {
            "top": {
              "type": "number"
            },
            "right": {
              "type": "number"
            },
            "bottom": {
              "type": "number"
            },
            "left": {
              "type": "number"
            }
          }
        }
      }
    },
    "shape_rules": {
      "type": "object",
      "additionalProperties": true
    },
    "chart_rules": {
      "type": "object"
    },
    "image_rules": {
      "type": "object"
    },
    "icon_rules": {
      "type": "object"
    },
    "layout_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_same_family_consecutive",
        "max_bento_ratio",
        "min_gap"
      ],
      "properties": {
        "max_same_family_consecutive": {
          "type": "integer",
          "minimum": 1
        },
        "max_bento_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_gap": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "forbidden_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "font_fallbacks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "brand_assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AST-[0-9]{3}$"
      }
    },
    "art_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "path", "content_hash", "provider"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^ADP-[A-F0-9]{16}$"},
        "path": {
          "type": "string",
          "pattern": "^\\.slidethus/art-direction/packets/[a-f0-9]{64}\\.json$"
        },
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "mode"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "mode": {"type": "string", "minLength": 1}
          }
        },
        "pre_layout_seed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seed_id", "path", "content_hash", "provider"],
          "properties": {
            "seed_id": {"type": "string", "pattern": "^ADS-[A-F0-9]{16}$"},
            "path": {"type": "string", "pattern": "^\\.slidethus/art-direction/seeds/[a-f0-9]{64}\\.json$"},
            "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "mode"],
              "properties": {
                "name": {"type": "string", "minLength": 1, "maxLength": 128},
                "version": {"type": "string", "minLength": 1, "maxLength": 128},
                "mode": {"type": "string", "minLength": 1, "maxLength": 128}
              }
            }
          }
        }
      }
    },
    "capability_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "contract_version", "capability_id", "contract_hash"],
      "properties": {
        "backend": {"const": "artifact-tool"},
        "contract_version": {"const": "2.0.0"},
        "capability_id": {"const": "artifact-tool-closed-grammar-v2"},
        "contract_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "grammar": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "page_families", "component_variants", "prohibited_combinations"],
      "properties": {
        "capability_id": {"const": "artifact-tool-closed-grammar-v2"},
        "page_families": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["family_id", "purpose"],
            "properties": {
              "family_id": {"type": "string", "pattern": "^family-[a-z0-9-]{2,63}$"},
              "purpose": {"type": "string", "minLength": 1, "maxLength": 500}
            }
          }
        },
        "component_variants": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["variant_id", "representation_kind", "producer_behavior"],
            "properties": {
              "variant_id": {"type": "string", "pattern": "^variant-[a-z0-9-]{2,63}$"},
              "representation_kind": {"enum": ["text", "typographic", "image", "chart", "table", "diagram", "mixed"]},
              "producer_behavior": {"enum": ["text_focus", "image_frame", "native_chart", "native_table", "editable_diagram", "mixed_regions"]}
            }
          }
        },
        "prohibited_combinations": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "render_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engine_version", "generated_at", "inputs"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "inputs": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_type", "version", "content_hash"],
            "properties": {
              "artifact_type": {
                "enum": ["project_brief", "deck_outline", "slide_specs", "layout_plans", "asset_manifest"]
              },
              "version": {"type": "integer", "minimum": 1},
              "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"pattern": "^0\\.2\\."}}},
      "then": {
        "required": ["capability_contract", "grammar", "page_designs"],
        "properties": {
          "page_designs": {
            "items": {
              "required": ["page_family_id", "component_variant_id"],
              "properties": {
                "regions": {"items": {"required": ["style_id"]}}
              }
            }
          }
        }
      }
    }
  ]
}
