{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/semantic-scorecard-report.schema.json",
  "title": "Semantic Scorecard Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "report_id", "review_mode", "provider",
    "capability", "source_review", "dimensions", "summary", "status"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "report_id": {"type": "string", "pattern": "^SCR-[A-F0-9]{16}$"},
    "review_mode": {"const": "scorecard"},
    "provider": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": {"enum": ["available", "missing"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "source_review": {
      "type": "object", "additionalProperties": false,
      "required": ["report_id", "path", "sha256", "status"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^SVR-[A-F0-9]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["pass", "issues", "blocked"]}
      }
    },
    "dimensions": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension", "score", "rationale", "issue_ids"],
        "properties": {
          "dimension": {
            "enum": [
              "purpose_fit", "audience_fit", "factual_integrity", "narrative_coherence",
              "slide_clarity", "evidence_sufficiency", "presentation_usability"
            ]
          },
          "score": {"type": "integer", "minimum": 0, "maximum": 5},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 3000},
          "issue_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^SRI-[A-F0-9]{16}$"}
          }
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["overall_score", "blocking_count", "minimum_score"],
      "properties": {
        "overall_score": {"type": "number", "minimum": 0, "maximum": 5},
        "blocking_count": {"type": "integer", "minimum": 0},
        "minimum_score": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "status": {"enum": ["pass", "issues", "blocked"]}
  }
}
