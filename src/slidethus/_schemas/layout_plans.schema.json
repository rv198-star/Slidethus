{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/layout-plans.schema.json",
  "title": "Layout Plans",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "deck_id",
    "canvas",
    "safe_area",
    "plans"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "deck_id": {
      "type": "string",
      "pattern": "^DECK-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "status": {"enum": ["draft", "reviewed", "approved", "frozen"]},
    "repair_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^PRP-[A-F0-9]{16}$"}
    },
    "planning_lineage": {"$ref": "#/$defs/planningLineage"},
    "wireframes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_id", "path", "sha256", "mime_type", "width", "height"],
        "properties": {
          "slide_id": {"type": "string", "pattern": "^S-[0-9]{3}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "mime_type": {"const": "image/svg+xml"},
          "width": {"type": "integer", "minimum": 100},
          "height": {"type": "integer", "minimum": 100}
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 100
        },
        "height": {
          "type": "integer",
          "minimum": 100
        }
      }
    },
    "safe_area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "properties": {
        "top": {
          "type": "number",
          "minimum": 0
        },
        "right": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        },
        "left": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_id",
          "layout_family",
          "reading_order",
          "regions",
          "rationale"
        ],
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^S-[0-9]{3}$"
          },
          "status": {"enum": ["draft", "reviewed", "approved", "frozen"]},
          "slide_spec_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slide_id", "content_hash"],
            "properties": {
              "slide_id": {"type": "string", "pattern": "^S-[0-9]{3}$"},
              "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          },
          "revision_note": {"type": "string"},
          "layout_family": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "reading_order": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REG-S[0-9]{3}-[0-9]{2}$"
            }
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "region_id",
                "block_id",
                "x",
                "y",
                "w",
                "h",
                "z",
                "align",
                "valign",
                "overflow_strategy"
              ],
              "properties": {
                "region_id": {
                  "type": "string",
                  "pattern": "^REG-S[0-9]{3}-[0-9]{2}$"
                },
                "block_id": {
                  "type": "string",
                  "pattern": "^BLK-S[0-9]{3}-[0-9]{2}$"
                },
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0
                },
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "z": {
                  "type": "integer",
                  "minimum": 0
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "valign": {
                  "enum": [
                    "top",
                    "middle",
                    "bottom"
                  ]
                },
                "overflow_strategy": {
                  "enum": [
                    "fail",
                    "wrap",
                    "shrink_with_floor",
                    "clip",
                    "paginate"
                  ]
                },
                "role": {
                  "type": "string"
                },
                "min_font_pt": {"type": "number", "minimum": 8},
                "content_capacity_units": {"type": "integer", "minimum": 1},
                "source_block_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
              }
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "grid_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "diagnostics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["block_count", "region_count", "content_units", "capacity_units", "warnings"],
            "properties": {
              "block_count": {"type": "integer", "minimum": 1},
              "region_count": {"type": "integer", "minimum": 1},
              "content_units": {"type": "integer", "minimum": 0},
              "capacity_units": {"type": "integer", "minimum": 1},
              "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "version", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "planningLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id", "engine", "engine_version", "provider", "generated_at",
        "proposal_hash", "policy", "policy_hash", "input_refs", "warnings", "assumptions"
      ],
      "properties": {
        "lineage_id": {"type": "string", "pattern": "^PLN-[A-F0-9]{16}$"},
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "generated_at": {"type": "string", "format": "date-time"},
        "proposal_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "limits"],
          "properties": {
            "service": {"enum": ["narrative", "outline", "slide_specs", "layout"]},
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_blocking_questions", "max_assumptions", "max_sections", "max_slides",
                "max_blocks_per_slide", "max_words_per_slide", "max_provider_payload_bytes",
                "max_change_targets"
              ],
              "properties": {
                "max_blocking_questions": {"type": "integer", "minimum": 1},
                "max_assumptions": {"type": "integer", "minimum": 1},
                "max_sections": {"type": "integer", "minimum": 1},
                "max_slides": {"type": "integer", "minimum": 1},
                "max_blocks_per_slide": {"type": "integer", "minimum": 1},
                "max_words_per_slide": {"type": "integer", "minimum": 1},
                "max_provider_payload_bytes": {"type": "integer", "minimum": 1},
                "max_change_targets": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "policy_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "input_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
        "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
