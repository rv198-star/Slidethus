{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/visual-quality-review.schema.json",
  "title": "Immutable Visual Quality Review Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "review_id", "generated_at", "stage",
    "dependency_key", "reviewer", "image_set", "coverage", "findings"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "review_id": {"type": "string", "pattern": "^VQR-[A-F0-9]{16}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "stage": {"enum": ["direction", "planning", "calibration", "whole_deck"]},
    "dependency_key": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "capabilities", "independent_from_author"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "capabilities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["native_prototype", "semantic_preview", "office_pages", "whole_deck"]}
        },
        "independent_from_author": {"type": "boolean"}
      }
    },
    "image_set": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slide_id", "kind", "path", "sha256"],
        "properties": {
          "slide_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "kind": {"enum": ["native_prototype", "semantic_preview", "office_page"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "coverage": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$"}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "finding_id", "dimension", "normalized_issue", "severity", "earliest_owner",
          "slide_id", "page_sha256", "location", "finding", "impact", "recommended_fix"
        ],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^VQF-[A-F0-9]{16}$"},
          "dimension": {"type": "string", "pattern": "^[a-z0-9_]{2,80}$"},
          "normalized_issue": {"type": "string", "minLength": 1, "maxLength": 500},
          "severity": {"enum": ["critical", "major", "minor"]},
          "earliest_owner": {"enum": ["P4", "direction", "P5A", "P5B", "P6", "P7", "P8"]},
          "slide_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "page_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "location": {"type": "string", "minLength": 1, "maxLength": 500},
          "finding": {"type": "string", "minLength": 1, "maxLength": 4000},
          "impact": {"type": "string", "minLength": 1, "maxLength": 4000},
          "recommended_fix": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    }
  }
}
