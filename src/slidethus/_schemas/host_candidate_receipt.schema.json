{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slidethus.dev/schemas/host-candidate-receipt.schema.json",
  "title": "Host-rendered candidate, not release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "scope", "slide_ids", "renderer", "renderer_ir", "preflight", "outputs", "office_review", "release_approved"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "candidate_office_review_pending"},
    "scope": {"enum": ["sample", "full"]},
    "slide_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^S-[0-9]{3}$"}},
    "renderer": {"type": "object", "additionalProperties": false, "required": ["name", "version", "adapter_sha256"], "properties": {"name": {"const": "artifact-tool"}, "version": {"type": "string", "minLength": 1}, "adapter_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "renderer_ir": {"$ref": "#/$defs/file"},
    "preflight": {"$ref": "#/$defs/file"},
    "outputs": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/file"}},
    "office_review": {"const": "pending"},
    "release_approved": {"const": false}
  },
  "$defs": {"file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
}
